{
	"name": "@datamoc/mwg-retro-audio",
	"version": "0.4.0",
	"description": "Historical synthesizers and sound chips for mwg games, and a universal player for pre-MP3 electronic music: pure TypeScript (YM2149/AY, SID, NES APU, SN76489, YM2612, YM2151, OPL2/OPL3, DX7 and other historical synths) on the native Web Audio API, with players for YM, VGM/VGZ, NSF/NSFE, PSID, SPC, MIDI/XMI, MOD/XM/S3M/IT, DRO, IMF, CMF, HSC, RAD, ROL, D00, SCI, WAV and VOC files",
	"type": "module",
	"license": "MPL-2.0",
	"funding": {
		"type": "individual",
		"url": "https://buy.stripe.com/bJe8wOeUq4oZ2kXfyeaIM00"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		"./node/french-phonemizer": {
			"types": "./dist/node/frenchPhonemizer.d.ts",
			"default": "./dist/node/frenchPhonemizer.js"
		},
		"./speech/kokoro": {
			"types": "./dist/speech/KokoroSpeech.d.ts",
			"default": "./dist/speech/KokoroSpeech.js"
		},
		"./node/speech": {
			"types": "./dist/node/windowsSpeech.d.ts",
			"default": "./dist/node/windowsSpeech.js"
		},
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./chips": {
			"types": "./dist/chips/index.d.ts",
			"default": "./dist/chips/index.js"
		},
		"./formats": {
			"types": "./dist/formats/index.d.ts",
			"default": "./dist/formats/index.js"
		},
		"./driver": {
			"types": "./dist/driver/index.d.ts",
			"default": "./dist/driver/index.js"
		},
		"./sfx": {
			"types": "./dist/sfx/index.d.ts",
			"default": "./dist/sfx/index.js"
		},
		"./mwg": {
			"types": "./dist/mwg/index.d.ts",
			"default": "./dist/mwg/index.js"
		},
		"./mwg/worker-cores": {
			"types": "./dist/mwg/worker-cores.d.ts",
			"default": "./dist/mwg/worker-cores.js"
		},
		"./mwg/worker-cores/*": {
			"types": "./dist/mwg/worker-cores/*.d.ts",
			"default": "./dist/mwg/worker-cores/*.js"
		},
		"./mwg/catalogue": {
			"types": "./dist/mwg/catalogueEngines.d.ts",
			"default": "./dist/mwg/catalogueEngines.js"
		},
		"./instruments": {
			"types": "./dist/instruments/index.d.ts",
			"default": "./dist/instruments/index.js"
		},
		"./instruments/*": {
			"types": "./dist/instruments/*.d.ts",
			"default": "./dist/instruments/*.js"
		},
		"./chips/*": {
			"types": "./dist/chips/*.d.ts",
			"default": "./dist/chips/*.js"
		},
		"./driver/*": {
			"types": "./dist/driver/*.d.ts",
			"default": "./dist/driver/*.js"
		},
		"./formats/*": {
			"types": "./dist/formats/*.d.ts",
			"default": "./dist/formats/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"src",
		"docs",
		"README.md",
		"CHANGELOG.md",
		"CONFORMANCE.md",
		"NOTICE",
		"LICENSE"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=20.19.0"
	},
	"scripts": {
		"check": "tsc --noEmit -p .",
		"test": "node --import tsx --test \"tests/**/*.test.ts\"",
		"build": "tsc -p tsconfig.build.json && node tools/build-worker-cores.mjs",
		"check:bundles": "npm run build && node tools/bundle-check.mjs",
		"check:piano": "node tools/piano-check.mjs",
		"build:demo": "node tools/build-demo.mjs",
		"format": "prettier --write src tests",
		"format:check": "prettier --check src tests"
	},
	"peerDependencies": {
		"@huggingface/transformers": "^3.8.1",
		"kokoro-js": "^1.2.1",
		"@datamoc/mwg": "^0.49.0"
	},
	"peerDependenciesMeta": {
		"@huggingface/transformers": {
			"optional": true
		},
		"kokoro-js": {
			"optional": true
		},
		"@datamoc/mwg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@huggingface/transformers": "^3.8.1",
		"@datamoc/mwg": "file:../mwg",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"kokoro-js": "^1.2.1",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	}
}
